  28              		.file 1 "simpleserial-smaug.c"
   1:simpleserial-smaug.c **** // SimpleSerial-SMAUG: ChipWhisperer SCA target wrapper around SMAUG-T KEM.
   2:simpleserial-smaug.c **** //
   3:simpleserial-smaug.c **** // Commands (SimpleSerial v2.1):
   4:simpleserial-smaug.c **** //   k  - generate fresh (pk, sk) on-chip; reply 'r' carries first 16 B of pk
   5:simpleserial-smaug.c **** //   e  - encapsulate against the resident pk (no trigger); reply 'r' = first 16 B of ct
   6:simpleserial-smaug.c **** //   d  - decapsulate the resident ct with sk; TRIGGER HIGH around the call
   7:simpleserial-smaug.c **** //        reply 'r' = 1-byte mismatch flag (0 = ss_dec == ss_enc)
   8:simpleserial-smaug.c **** //   p  - full pipeline: keypair -> enc -> (trigger high) dec (trigger low)
   9:simpleserial-smaug.c **** //        single-shot capture helper; reply 'r' = 1-byte mismatch flag
  10:simpleserial-smaug.c **** //
  11:simpleserial-smaug.c **** // All key/ct buffers stay resident on the MCU; the host never sees the full
  12:simpleserial-smaug.c **** // 672 B pk/ct (would exceed SimpleSerial's 64 B-per-frame limit).
  13:simpleserial-smaug.c **** 
  14:simpleserial-smaug.c **** #include <stdint.h>
  15:simpleserial-smaug.c **** 
  16:simpleserial-smaug.c **** #include "hal.h"
  17:simpleserial-smaug.c **** #include "simpleserial.h"
  18:simpleserial-smaug.c **** 
  19:simpleserial-smaug.c **** #include "api.h"          // CRYPTO_{PUBLICKEY,SECRETKEY,CIPHERTEXT}BYTES
  20:simpleserial-smaug.c **** #include "parameters.h"   // CRYPTO_BYTES (= 32, shared-secret size)
  21:simpleserial-smaug.c **** 
  22:simpleserial-smaug.c **** extern int crypto_kem_keypair(uint8_t *pk, uint8_t *sk);
  23:simpleserial-smaug.c **** extern int crypto_kem_enc(uint8_t *ct, uint8_t *ss, const uint8_t *pk);
  24:simpleserial-smaug.c **** extern int crypto_kem_dec(uint8_t *ss, const uint8_t *ct, const uint8_t *sk);
  25:simpleserial-smaug.c **** 
  26:simpleserial-smaug.c **** static uint8_t pk[CRYPTO_PUBLICKEYBYTES];
  27:simpleserial-smaug.c **** static uint8_t sk[CRYPTO_SECRETKEYBYTES];
  28:simpleserial-smaug.c **** static uint8_t ct[CRYPTO_CIPHERTEXTBYTES];
  29:simpleserial-smaug.c **** static uint8_t ss_enc[CRYPTO_BYTES];
  30:simpleserial-smaug.c **** static uint8_t ss_dec[CRYPTO_BYTES];
  31:simpleserial-smaug.c **** 
  32:simpleserial-smaug.c **** static uint8_t cmd_keypair(uint8_t cmd, uint8_t scmd, uint8_t len, uint8_t *buf)
  33:simpleserial-smaug.c **** {
  34:simpleserial-smaug.c ****     (void)cmd; (void)scmd; (void)len; (void)buf;
  35:simpleserial-smaug.c ****     crypto_kem_keypair(pk, sk);
  36:simpleserial-smaug.c ****     simpleserial_put('r', 16, pk);
  37:simpleserial-smaug.c ****     return 0x00;
  38:simpleserial-smaug.c **** }
  39:simpleserial-smaug.c **** 
  40:simpleserial-smaug.c **** static uint8_t cmd_encaps(uint8_t cmd, uint8_t scmd, uint8_t len, uint8_t *buf)
  41:simpleserial-smaug.c **** {
  42:simpleserial-smaug.c ****     (void)cmd; (void)scmd; (void)len; (void)buf;
  43:simpleserial-smaug.c ****     crypto_kem_enc(ct, ss_enc, pk);
  44:simpleserial-smaug.c ****     simpleserial_put('r', 16, ct);
  45:simpleserial-smaug.c ****     return 0x00;
  46:simpleserial-smaug.c **** }
  47:simpleserial-smaug.c **** 
  48:simpleserial-smaug.c **** static uint8_t cmd_decaps(uint8_t cmd, uint8_t scmd, uint8_t len, uint8_t *buf)
  49:simpleserial-smaug.c **** {
  50:simpleserial-smaug.c ****     (void)cmd; (void)scmd; (void)len; (void)buf;
  51:simpleserial-smaug.c **** 
  52:simpleserial-smaug.c ****     trigger_high();
  53:simpleserial-smaug.c ****     crypto_kem_dec(ss_dec, ct, sk);
  54:simpleserial-smaug.c ****     trigger_low();
  55:simpleserial-smaug.c **** 
  56:simpleserial-smaug.c ****     uint8_t mismatch = 0;
  57:simpleserial-smaug.c ****     for (unsigned i = 0; i < CRYPTO_BYTES; i++) {
  58:simpleserial-smaug.c ****         mismatch |= (uint8_t)(ss_dec[i] ^ ss_enc[i]);
  59:simpleserial-smaug.c ****     }
  60:simpleserial-smaug.c ****     uint8_t status = (mismatch != 0);
  61:simpleserial-smaug.c ****     simpleserial_put('r', 1, &status);
  62:simpleserial-smaug.c ****     return 0x00;
  63:simpleserial-smaug.c **** }
  64:simpleserial-smaug.c **** 
