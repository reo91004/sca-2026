  28              		.file 1 "simpleserial-smaug.c"
   1:simpleserial-smaug.c **** // SimpleSerial-SMAUG: ChipWhisperer SCA target wrapper around SMAUG-T KEM.
   2:simpleserial-smaug.c **** //
   3:simpleserial-smaug.c **** // Commands (SimpleSerial v1.1; matches HQC reference firmware so 0x44 ack
   4:simpleserial-smaug.c **** // behavior can be compared apples-to-apples between the two KEMs):
   5:simpleserial-smaug.c **** //   k  - generate fresh (pk, sk) on-chip; reply 'r' carries first 16 B of pk
   6:simpleserial-smaug.c **** //   e  - encapsulate against the resident pk (no trigger); reply 'r' = first 16 B of ct
   7:simpleserial-smaug.c **** //   d  - decapsulate the resident ct with sk; TRIGGER HIGH around the call
   8:simpleserial-smaug.c **** //        reply 'r' = 1-byte mismatch flag (0 = ss_dec == ss_enc)
   9:simpleserial-smaug.c **** //   p  - full pipeline: keypair -> enc -> (trigger high) dec (trigger low)
  10:simpleserial-smaug.c **** //        single-shot capture helper; reply 'r' = 1-byte mismatch flag
  11:simpleserial-smaug.c **** //
  12:simpleserial-smaug.c **** // All key/ct buffers stay resident on the MCU; the host never sees the full
  13:simpleserial-smaug.c **** // 672 B pk/ct (would exceed SimpleSerial's 64 B-per-frame limit).
  14:simpleserial-smaug.c **** 
  15:simpleserial-smaug.c **** #include <stdint.h>
  16:simpleserial-smaug.c **** 
  17:simpleserial-smaug.c **** #include "hal.h"
  18:simpleserial-smaug.c **** #include "simpleserial.h"
  19:simpleserial-smaug.c **** 
  20:simpleserial-smaug.c **** #include "api.h"          // CRYPTO_{PUBLICKEY,SECRETKEY,CIPHERTEXT}BYTES
  21:simpleserial-smaug.c **** #include "parameters.h"   // CRYPTO_BYTES (= 32, shared-secret size)
  22:simpleserial-smaug.c **** 
  23:simpleserial-smaug.c **** extern int crypto_kem_keypair(uint8_t *pk, uint8_t *sk);
  24:simpleserial-smaug.c **** extern int crypto_kem_enc(uint8_t *ct, uint8_t *ss, const uint8_t *pk);
  25:simpleserial-smaug.c **** extern int crypto_kem_dec(uint8_t *ss, const uint8_t *ct, const uint8_t *sk);
  26:simpleserial-smaug.c **** 
  27:simpleserial-smaug.c **** static uint8_t pk[CRYPTO_PUBLICKEYBYTES];
  28:simpleserial-smaug.c **** static uint8_t sk[CRYPTO_SECRETKEYBYTES];
  29:simpleserial-smaug.c **** static uint8_t ct[CRYPTO_CIPHERTEXTBYTES];
  30:simpleserial-smaug.c **** static uint8_t ss_enc[CRYPTO_BYTES];
  31:simpleserial-smaug.c **** static uint8_t ss_dec[CRYPTO_BYTES];
  32:simpleserial-smaug.c **** 
  33:simpleserial-smaug.c **** static uint8_t cmd_keypair(uint8_t *buf, uint8_t len)
  34:simpleserial-smaug.c **** {
  35:simpleserial-smaug.c ****     (void)len; (void)buf;
  36:simpleserial-smaug.c ****     crypto_kem_keypair(pk, sk);
  37:simpleserial-smaug.c ****     simpleserial_put('r', 16, pk);
  38:simpleserial-smaug.c ****     return 0x00;
  39:simpleserial-smaug.c **** }
  40:simpleserial-smaug.c **** 
  41:simpleserial-smaug.c **** static uint8_t cmd_encaps(uint8_t *buf, uint8_t len)
  42:simpleserial-smaug.c **** {
  43:simpleserial-smaug.c ****     (void)len; (void)buf;
  44:simpleserial-smaug.c ****     crypto_kem_enc(ct, ss_enc, pk);
  45:simpleserial-smaug.c ****     simpleserial_put('r', 16, ct);
  46:simpleserial-smaug.c ****     return 0x00;
  47:simpleserial-smaug.c **** }
  48:simpleserial-smaug.c **** 
  49:simpleserial-smaug.c **** static uint8_t cmd_decaps(uint8_t *buf, uint8_t len)
  50:simpleserial-smaug.c **** {
  51:simpleserial-smaug.c ****     (void)len; (void)buf;
  52:simpleserial-smaug.c **** 
  53:simpleserial-smaug.c ****     trigger_high();
  54:simpleserial-smaug.c ****     crypto_kem_dec(ss_dec, ct, sk);
  55:simpleserial-smaug.c ****     trigger_low();
  56:simpleserial-smaug.c **** 
  57:simpleserial-smaug.c ****     uint8_t mismatch = 0;
  58:simpleserial-smaug.c ****     for (unsigned i = 0; i < CRYPTO_BYTES; i++) {
  59:simpleserial-smaug.c ****         mismatch |= (uint8_t)(ss_dec[i] ^ ss_enc[i]);
  60:simpleserial-smaug.c ****     }
  61:simpleserial-smaug.c ****     uint8_t status = (mismatch != 0);
  62:simpleserial-smaug.c ****     simpleserial_put('r', 1, &status);
  63:simpleserial-smaug.c ****     return 0x00;
  64:simpleserial-smaug.c **** }
  65:simpleserial-smaug.c **** 
