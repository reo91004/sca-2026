  64:simpleserial-hqc-pqclean.c **** /*
  65:simpleserial-hqc-pqclean.c ****  * Single byte RM encode with trigger
  66:simpleserial-hqc-pqclean.c ****  * Command 'e' + [1 dummy byte]
  67:simpleserial-hqc-pqclean.c ****  */
  68:simpleserial-hqc-pqclean.c **** uint8_t encode_single(uint8_t *data, uint8_t len) {
  69:simpleserial-hqc-pqclean.c ****     trigger_high();
  70:simpleserial-hqc-pqclean.c ****     encode(single_codeword, single_msg);
  71:simpleserial-hqc-pqclean.c ****     trigger_low();
  72:simpleserial-hqc-pqclean.c ****     simpleserial_put('r', 16, (uint8_t *)single_codeword);
  73:simpleserial-hqc-pqclean.c ****     return 0x00;
  74:simpleserial-hqc-pqclean.c **** }
  75:simpleserial-hqc-pqclean.c **** 
  76:simpleserial-hqc-pqclean.c **** /*
  77:simpleserial-hqc-pqclean.c ****  * Full 46-byte RM encode with single trigger
  78:simpleserial-hqc-pqclean.c ****  * Command 'p' + [optional first byte]
  79:simpleserial-hqc-pqclean.c ****  */
  80:simpleserial-hqc-pqclean.c **** uint8_t encode_full(uint8_t *data, uint8_t len) {
  81:simpleserial-hqc-pqclean.c ****     if (len > 0)
  82:simpleserial-hqc-pqclean.c ****         msg[0] = data[0];
  83:simpleserial-hqc-pqclean.c ****     trigger_high();
  84:simpleserial-hqc-pqclean.c ****     PQCLEAN_HQC128_CLEAN_reed_muller_encode(codeword, msg);
  85:simpleserial-hqc-pqclean.c ****     trigger_low();
  86:simpleserial-hqc-pqclean.c ****     simpleserial_put('r', 16, (uint8_t *)codeword);
  87:simpleserial-hqc-pqclean.c ****     return 0x00;
  88:simpleserial-hqc-pqclean.c **** }
  89:simpleserial-hqc-pqclean.c **** 
  90:simpleserial-hqc-pqclean.c **** /*
  91:simpleserial-hqc-pqclean.c ****  * Full 46-byte RM encode with per-byte triggers (46 pulses)
  92:simpleserial-hqc-pqclean.c ****  * Command 't' + [1 dummy byte]
  93:simpleserial-hqc-pqclean.c ****  */
  94:simpleserial-hqc-pqclean.c **** uint8_t encode_full_triggered(uint8_t *data, uint8_t len) {
  95:simpleserial-hqc-pqclean.c ****     for (size_t i = 0; i < PARAM_N1; i++) {
  96:simpleserial-hqc-pqclean.c ****         trigger_high();
  97:simpleserial-hqc-pqclean.c ****         encode(&codeword[2 * i * MULTIPLICITY], msg[i]);
  98:simpleserial-hqc-pqclean.c ****         trigger_low();
  99:simpleserial-hqc-pqclean.c ****         for (size_t copy = 1; copy < MULTIPLICITY; copy++) {
 100:simpleserial-hqc-pqclean.c ****             memcpy(&codeword[2 * i * MULTIPLICITY + 2 * copy],
 101:simpleserial-hqc-pqclean.c ****                    &codeword[2 * i * MULTIPLICITY], 16);
 102:simpleserial-hqc-pqclean.c ****         }
 103:simpleserial-hqc-pqclean.c ****     }
 104:simpleserial-hqc-pqclean.c ****     simpleserial_put('r', 16, (uint8_t *)codeword);
 105:simpleserial-hqc-pqclean.c ****     return 0x00;
 106:simpleserial-hqc-pqclean.c **** }
 107:simpleserial-hqc-pqclean.c **** 
