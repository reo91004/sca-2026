  26:simpleserial-hqc-pqclean.c **** 
  27:simpleserial-hqc-pqclean.c **** #define MULTIPLICITY 3  /* CEIL_DIVIDE(384, 128) */
  28:simpleserial-hqc-pqclean.c **** 
  29:simpleserial-hqc-pqclean.c **** /* Storage */
  30:simpleserial-hqc-pqclean.c **** static uint8_t msg[PARAM_N1];                      /* 46-byte message (RM input) */
  31:simpleserial-hqc-pqclean.c **** static uint64_t codeword[PARAM_N1 * MULTIPLICITY * 2]; /* 2208 bytes */
  32:simpleserial-hqc-pqclean.c **** 
  33:simpleserial-hqc-pqclean.c **** /* Single byte encode */
  34:simpleserial-hqc-pqclean.c **** static uint8_t single_msg;
  35:simpleserial-hqc-pqclean.c **** static uint64_t single_codeword[2];  /* 128 bits = 16 bytes */
  36:simpleserial-hqc-pqclean.c **** 
  37:simpleserial-hqc-pqclean.c **** /* code_encode: 16-byte original message (RS input) */
  38:simpleserial-hqc-pqclean.c **** static uint8_t original_msg[PARAM_K];  /* 16 bytes */
  39:simpleserial-hqc-pqclean.c **** 
  40:simpleserial-hqc-pqclean.c **** /*
  41:simpleserial-hqc-pqclean.c ****  * Set message chunk (46-byte RM input)
  42:simpleserial-hqc-pqclean.c ****  * Command 'm' + [offset] + [data bytes]
  43:simpleserial-hqc-pqclean.c ****  */
  44:simpleserial-hqc-pqclean.c **** uint8_t set_msg(uint8_t *data, uint8_t len) {
  45:simpleserial-hqc-pqclean.c ****     if (len < 2)
  46:simpleserial-hqc-pqclean.c ****         return 0x01;
  47:simpleserial-hqc-pqclean.c ****     uint8_t offset = data[0];
  48:simpleserial-hqc-pqclean.c ****     uint8_t copy_len = len - 1;
  49:simpleserial-hqc-pqclean.c ****     if (offset + copy_len > PARAM_N1)
  50:simpleserial-hqc-pqclean.c ****         copy_len = PARAM_N1 - offset;
  51:simpleserial-hqc-pqclean.c ****     memcpy(&msg[offset], &data[1], copy_len);
  52:simpleserial-hqc-pqclean.c ****     return 0x00;
  53:simpleserial-hqc-pqclean.c **** }
  54:simpleserial-hqc-pqclean.c **** 
