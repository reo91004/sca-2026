   1:simpleserial-hqc-pqclean.c **** /*
   2:simpleserial-hqc-pqclean.c ****     HQC PQClean code_encode for side-channel analysis
   3:simpleserial-hqc-pqclean.c ****     Uses PQCLEAN_HQC128_CLEAN implementation directly.
   4:simpleserial-hqc-pqclean.c **** 
   5:simpleserial-hqc-pqclean.c ****     Commands:
   6:simpleserial-hqc-pqclean.c ****       'm' + offset + data: Set message chunk (46-byte RM input)
   7:simpleserial-hqc-pqclean.c ****       'b' + 1 byte: Set single byte message
   8:simpleserial-hqc-pqclean.c ****       'e' + 1 byte: Encode single byte RM (returns 16 bytes)
   9:simpleserial-hqc-pqclean.c ****       't' + 1 byte: Encode full message RM with per-byte triggers (46 pulses)
  10:simpleserial-hqc-pqclean.c ****       'i' + 16 bytes: Set 16-byte original message (RS input)
  11:simpleserial-hqc-pqclean.c ****       'c' + 1 byte: PQCLEAN_HQC128_CLEAN_code_encode (single trigger)
  12:simpleserial-hqc-pqclean.c ****       'd' + 1 byte: code_encode with per-byte RM triggers (46 pulses)
  13:simpleserial-hqc-pqclean.c ****       'p' + data: Encode full message RM (single trigger)
  14:simpleserial-hqc-pqclean.c ****       'g' + chunk: Get codeword chunk
  15:simpleserial-hqc-pqclean.c ****       'x' + 1 byte: Reset
  16:simpleserial-hqc-pqclean.c **** */
  17:simpleserial-hqc-pqclean.c **** 
  18:simpleserial-hqc-pqclean.c **** #include "hal.h"
  19:simpleserial-hqc-pqclean.c **** #include "parameters.h"
