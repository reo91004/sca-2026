  28              		.file 1 "simpleserial-hqc-pqclean.c"
   1:simpleserial-hqc-pqclean.c **** /*
   2:simpleserial-hqc-pqclean.c ****     HQC PQClean code_encode for side-channel analysis
   3:simpleserial-hqc-pqclean.c ****     Uses PQCLEAN_HQC128_CLEAN implementation directly.
   4:simpleserial-hqc-pqclean.c **** 
   5:simpleserial-hqc-pqclean.c ****     Commands:
   6:simpleserial-hqc-pqclean.c ****       'm' + offset + data: Set message chunk (46-byte RM input)
   7:simpleserial-hqc-pqclean.c ****       'b' + 1 byte: Set single byte message
   8:simpleserial-hqc-pqclean.c ****       'e' + 1 byte: Encode single byte RM (returns 16 bytes)
   9:simpleserial-hqc-pqclean.c ****       't' + 1 byte: Encode full message RM with per-byte triggers (46 pulses)
  10:simpleserial-hqc-pqclean.c ****       'i' + 16 bytes: Set 16-byte original message (RS input)
  11:simpleserial-hqc-pqclean.c ****       'c' + 1 byte: PQCLEAN_HQC128_CLEAN_code_encode (single trigger)
  12:simpleserial-hqc-pqclean.c ****       'd' + 1 byte: code_encode with per-byte RM triggers (46 pulses)
  13:simpleserial-hqc-pqclean.c ****       'p' + data: Encode full message RM (single trigger)
  14:simpleserial-hqc-pqclean.c ****       'g' + chunk: Get codeword chunk
  15:simpleserial-hqc-pqclean.c ****       'x' + 1 byte: Reset
  16:simpleserial-hqc-pqclean.c **** */
  17:simpleserial-hqc-pqclean.c **** 
  18:simpleserial-hqc-pqclean.c **** #include "hal.h"
  19:simpleserial-hqc-pqclean.c **** #include "parameters.h"
  20:simpleserial-hqc-pqclean.c **** #include "reed_muller.h"
  21:simpleserial-hqc-pqclean.c **** #include "reed_solomon.h"
  22:simpleserial-hqc-pqclean.c **** #include "code.h"
  23:simpleserial-hqc-pqclean.c **** #include "simpleserial.h"
  24:simpleserial-hqc-pqclean.c **** #include <stdint.h>
  25:simpleserial-hqc-pqclean.c **** #include <string.h>
  26:simpleserial-hqc-pqclean.c **** 
  27:simpleserial-hqc-pqclean.c **** #define MULTIPLICITY 3  /* CEIL_DIVIDE(384, 128) */
  28:simpleserial-hqc-pqclean.c **** 
  29:simpleserial-hqc-pqclean.c **** /* Storage */
  30:simpleserial-hqc-pqclean.c **** static uint8_t msg[PARAM_N1];                      /* 46-byte message (RM input) */
  31:simpleserial-hqc-pqclean.c **** static uint64_t codeword[PARAM_N1 * MULTIPLICITY * 2]; /* 2208 bytes */
  32:simpleserial-hqc-pqclean.c **** 
  33:simpleserial-hqc-pqclean.c **** /* Single byte encode */
  34:simpleserial-hqc-pqclean.c **** static uint8_t single_msg;
  35:simpleserial-hqc-pqclean.c **** static uint64_t single_codeword[2];  /* 128 bits = 16 bytes */
  36:simpleserial-hqc-pqclean.c **** 
  37:simpleserial-hqc-pqclean.c **** /* code_encode: 16-byte original message (RS input) */
  38:simpleserial-hqc-pqclean.c **** static uint8_t original_msg[PARAM_K];  /* 16 bytes */
  39:simpleserial-hqc-pqclean.c **** 
  40:simpleserial-hqc-pqclean.c **** /*
  41:simpleserial-hqc-pqclean.c ****  * Set message chunk (46-byte RM input)
  42:simpleserial-hqc-pqclean.c ****  * Command 'm' + [offset] + [data bytes]
  43:simpleserial-hqc-pqclean.c ****  */
  44:simpleserial-hqc-pqclean.c **** uint8_t set_msg(uint8_t *data, uint8_t len) {
  45:simpleserial-hqc-pqclean.c ****     if (len < 2)
  46:simpleserial-hqc-pqclean.c ****         return 0x01;
  47:simpleserial-hqc-pqclean.c ****     uint8_t offset = data[0];
  48:simpleserial-hqc-pqclean.c ****     uint8_t copy_len = len - 1;
  49:simpleserial-hqc-pqclean.c ****     if (offset + copy_len > PARAM_N1)
  50:simpleserial-hqc-pqclean.c ****         copy_len = PARAM_N1 - offset;
  51:simpleserial-hqc-pqclean.c ****     memcpy(&msg[offset], &data[1], copy_len);
  52:simpleserial-hqc-pqclean.c ****     return 0x00;
  53:simpleserial-hqc-pqclean.c **** }
  54:simpleserial-hqc-pqclean.c **** 
  55:simpleserial-hqc-pqclean.c **** /*
  56:simpleserial-hqc-pqclean.c ****  * Set single byte message
  57:simpleserial-hqc-pqclean.c ****  * Command 'b' + [1 byte]
  58:simpleserial-hqc-pqclean.c ****  */
