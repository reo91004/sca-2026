  10:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** /**
  11:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * @brief Computes the number of trailing zero bits.
  12:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  *
  13:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * @returns The number of trailing zero bits in a.
  14:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * @param[in] a An operand
  15:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  */
  16:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** static uint16_t trailing_zero_bits_count(uint16_t a) {
  17:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint16_t tmp = 0;
  18:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint16_t mask = 0xFFFF;
  19:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     for (size_t i = 0; i < 14; ++i) {
  20:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         tmp += ((1 - ((a >> i) & 0x0001)) & mask);
  21:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         mask &= - (1 - ((a >> i) & 0x0001));
  22:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     }
  23:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     return tmp;
  24:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** }
  25:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  26:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** /**
  27:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * Reduces polynomial x modulo primitive polynomial GF_POLY.
  28:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * @returns x mod GF_POLY
  29:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * @param[in] x Polynomial of degree less than 64
  30:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * @param[in] deg_x The degree of polynomial x
  31:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  */
  32:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** static uint16_t gf_reduce(uint64_t x, size_t deg_x) {
  33:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint16_t z1, z2, rmdr, dist;
  34:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint64_t mod;
  35:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  36:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     // Deduce the number of steps of reduction
  37:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     size_t steps = CEIL_DIVIDE(deg_x - (PARAM_M - 1), PARAM_GF_POLY_M2);
  38:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  39:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     // Reduce
  40:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     for (size_t i = 0; i < steps; ++i) {
  41:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         mod = x >> PARAM_M;
  42:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         x &= (1 << PARAM_M) - 1;
  43:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         x ^= mod;
  44:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  45:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         z1 = 0;
  46:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         rmdr = PARAM_GF_POLY ^ 1;
  47:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         for (size_t j = PARAM_GF_POLY_WT - 2; j; --j) {
  48:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             z2 = trailing_zero_bits_count(rmdr);
  49:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             dist = z2 - z1;
  50:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             mod <<= dist;
  51:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             x ^= mod;
  52:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             rmdr ^= 1 << z2;
  53:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             z1 = z2;
  54:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         }
  55:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     }
  56:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  57:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     return (uint16_t)x;
  58:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** }
