  64:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  * with s = 2 and w = 8
  65:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****  *
