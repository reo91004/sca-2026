  36:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     // Deduce the number of steps of reduction
  37:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     size_t steps = CEIL_DIVIDE(deg_x - (PARAM_M - 1), PARAM_GF_POLY_M2);
