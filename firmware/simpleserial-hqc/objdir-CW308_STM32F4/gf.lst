  70:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** static void gf_carryless_mul(uint8_t c[2], uint8_t a, uint8_t b) {
  71:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint16_t h = 0, l = 0, g = 0, u[4];
  72:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint32_t tmp1, tmp2;
  73:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint16_t mask;
  74:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     u[0] = 0;
  75:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     u[1] = b & 0x7F;
  76:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     u[2] = u[1] << 1;
  77:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     u[3] = u[2] ^ u[1];
  78:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     tmp1 = a & 3;
  79:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  80:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     for (size_t i = 0; i < 4; i++) {
  81:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         tmp2 = (uint32_t)(tmp1 - i);
  82:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         g ^= (u[i] & (uint32_t)(0 - (1 - ((uint32_t)(tmp2 | (0 - tmp2)) >> 31))));
  83:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     }
  84:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  85:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     l = g;
  86:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     h = 0;
  87:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  88:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     for (size_t i = 2; i < 8; i += 2) {
  89:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         g = 0;
