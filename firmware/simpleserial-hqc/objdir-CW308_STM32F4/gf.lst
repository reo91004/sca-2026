  39:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     // Reduce
  40:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     for (size_t i = 0; i < steps; ++i) {
  41:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         mod = x >> PARAM_M;
  42:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         x &= (1 << PARAM_M) - 1;
  43:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         x ^= mod;
  44:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
  45:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         z1 = 0;
  46:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         rmdr = PARAM_GF_POLY ^ 1;
  47:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         for (size_t j = PARAM_GF_POLY_WT - 2; j; --j) {
  48:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             z2 = trailing_zero_bits_count(rmdr);
  49:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             dist = z2 - z1;
  50:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             mod <<= dist;
  51:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             x ^= mod;
  52:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             rmdr ^= 1 << z2;
  53:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****             z1 = z2;
  54:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         }
  55:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     }
  56:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** 
