  16:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c **** static uint16_t trailing_zero_bits_count(uint16_t a) {
  17:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint16_t tmp = 0;
  18:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     uint16_t mask = 0xFFFF;
  19:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     for (size_t i = 0; i < 14; ++i) {
  20:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         tmp += ((1 - ((a >> i) & 0x0001)) & mask);
  21:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****         mask &= - (1 - ((a >> i) & 0x0001));
  22:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     }
  23:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/gf.c ****     return tmp;
