  18:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** 
  19:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** /**
  20:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @brief Computes the basis of betas (omitting 1) used in the additive FFT and its transpose
  21:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  *
  22:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @param[out] betas Array of size PARAM_M-1
  23:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  */
  24:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** static void compute_fft_betas(uint16_t *betas) {
  25:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     size_t i;
  26:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     for (i = 0; i < PARAM_M - 1; ++i) {
  27:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****         betas[i] = 1 << (PARAM_M - 1 - i);
  28:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     }
  29:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** }
  30:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** 
  31:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** /**
  32:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @brief Computes the subset sums of the given set
  33:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  *
  34:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * The array subset_sums is such that its ith element is
  35:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * the subset sum of the set elements given by the binary form of i.
  36:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  *
  37:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @param[out] subset_sums Array of size 2^set_size receiving the subset sums
  38:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @param[in] set Array of set_size elements
  39:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @param[in] set_size Size of the array set
  40:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  */
  41:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** static void compute_subset_sums(uint16_t *subset_sums, const uint16_t *set, uint16_t set_size) {
  42:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     uint16_t i, j;
  43:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     subset_sums[0] = 0;
  44:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** 
  45:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     for (i = 0; i < set_size; ++i) {
  46:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****         for (j = 0; j < (1 << i); ++j) {
  47:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****             subset_sums[(1 << i) + j] = set[i] ^ subset_sums[j];
  48:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****         }
  49:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     }
  50:/home/reo/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** }
