  31:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** /**
  32:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @brief Computes the subset sums of the given set
  33:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  *
  34:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * The array subset_sums is such that its ith element is
  35:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * the subset sum of the set elements given by the binary form of i.
  36:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  *
  37:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @param[out] subset_sums Array of size 2^set_size receiving the subset sums
  38:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @param[in] set Array of set_size elements
  39:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  * @param[in] set_size Size of the array set
  40:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****  */
  41:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** static void compute_subset_sums(uint16_t *subset_sums, const uint16_t *set, uint16_t set_size) {
  42:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     uint16_t i, j;
  43:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     subset_sums[0] = 0;
  44:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** 
  45:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     for (i = 0; i < set_size; ++i) {
  46:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****         for (j = 0; j < (1 << i); ++j) {
  47:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****             subset_sums[(1 << i) + j] = set[i] ^ subset_sums[j];
  48:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****         }
  49:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     }
  50:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** }
