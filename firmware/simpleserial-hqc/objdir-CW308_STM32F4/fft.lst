  24:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** static void compute_fft_betas(uint16_t *betas) {
  25:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     size_t i;
  26:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     for (i = 0; i < PARAM_M - 1; ++i) {
  27:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****         betas[i] = 1 << (PARAM_M - 1 - i);
  28:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c ****     }
  29:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/fft.c **** }
