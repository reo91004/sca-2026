   5:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** /**
   6:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @file reed_muller.c
   7:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @brief Constant time implementation of Reed-Muller code RM(1,7)
   8:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  */
   9:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** 
  10:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** // number of repeated code words
  11:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** #define MULTIPLICITY                   CEIL_DIVIDE(PARAM_N2, 128)
  12:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** 
  13:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** // copy bit 0 into all bits of a 32 bit value
  14:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** #define BIT0MASK(x) (uint32_t)(-((x) & 1))
  15:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** 
  16:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** /**
  17:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @brief Encode a single byte into a single codeword using RM(1,7)
  18:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  *
  19:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * Encoding matrix of this code:
  20:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * bit pattern (note that bits are numbered big endian)
  21:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 0   aaaaaaaa aaaaaaaa aaaaaaaa aaaaaaaa
  22:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 1   cccccccc cccccccc cccccccc cccccccc
  23:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 2   f0f0f0f0 f0f0f0f0 f0f0f0f0 f0f0f0f0
  24:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 3   ff00ff00 ff00ff00 ff00ff00 ff00ff00
  25:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 4   ffff0000 ffff0000 ffff0000 ffff0000
  26:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 5   ffffffff 00000000 ffffffff 00000000
  27:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 6   ffffffff ffffffff 00000000 00000000
  28:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * 7   ffffffff ffffffff ffffffff ffffffff
  29:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  *
  30:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @param[out] word An RM(1,7) codeword
  31:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @param[in] message A message
  32:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  */
  33:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** void encode(uint64_t *cword, uint8_t message) {
  34:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint32_t first_word;
  35:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // bit 7 flips all the bits, do that first to save work
  36:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word = BIT0MASK(message >> 7);
  37:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // bits 0, 1, 2, 3, 4 are the same for all four longs
  38:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // (Warning: in the bit matrix above, low bits are at the left!)
  39:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 0) & 0xaaaaaaaa;
  40:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 1) & 0xcccccccc;
  41:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 2) & 0xf0f0f0f0;
  42:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 3) & 0xff00ff00;
  43:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 4) & 0xffff0000;
  44:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // we can store this in the first quarter
  45:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     cword[0] = first_word;
  46:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // bit 5 flips entries 1 and 3; bit 6 flips 2 and 3
  47:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 5);
  48:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     cword[0] |= (uint64_t)first_word << 32;
  49:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 6);
  50:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     cword[1] = (uint64_t)first_word << 32;
  51:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     first_word ^= BIT0MASK(message >> 5);
  52:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     cword[1] |= first_word;
  53:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** }
  54:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** 
  55:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** /**
  56:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @brief Hadamard transform
  57:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  *
  58:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * Perform hadamard transform of src and store result in dst
  59:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * src is overwritten
  60:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  *
  61:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @param[out] src Structure that contain the expanded codeword
  62:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @param[out] dst Structure that contain the expanded codeword
  63:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  */
  64:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** static void hadamard(uint16_t src[128], uint16_t dst[128]) {
  65:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // the passes move data:
  66:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // src -> dst -> src -> dst -> src -> dst -> src -> dst
  67:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // using p1 and p2 alternately
  68:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint16_t *p1 = src;
  69:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint16_t *p2 = dst;
  70:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint16_t *p3;
  71:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     for (size_t pass = 0; pass < 7; ++pass) {
  72:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         for (size_t i = 0; i < 64; ++i) {
  73:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****             p2[i] = p1[2 * i] + p1[2 * i + 1];
  74:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****             p2[i + 64] = p1[2 * i] - p1[2 * i + 1];
  75:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         }
  76:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         // swap p1, p2 for next round
  77:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         p3 = p1;
  78:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         p1 = p2;
  79:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         p2 = p3;
  80:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     }
  81:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** }
  82:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** 
  83:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** /**
  84:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @brief Add multiple codewords into expanded codeword
