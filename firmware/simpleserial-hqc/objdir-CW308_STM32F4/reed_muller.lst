 116:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * This is the final step of the green machine: find the location of the highest value,
 117:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * and add 128 if the peak is positive
 118:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * if there are two identical peaks, the peak with smallest value
 119:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * in the lowest 7 bits it taken
 120:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  * @param[in] transform Structure that contain the expanded codeword
 121:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****  */
 122:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** static uint8_t find_peaks(const uint16_t transform[128]) {
 123:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint16_t peak_abs = 0;
 124:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint16_t peak = 0;
 125:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint16_t pos = 0;
 126:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     uint16_t t, abs, mask;
 127:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     for (uint16_t i = 0; i < 128; ++i) {
 128:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         t = transform[i];
 129:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         abs = t ^ ((uint16_t)(-(t >> 15)) & (t ^ -t)); // t = abs(t)
 130:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         mask = -(((uint16_t)(peak_abs - abs)) >> 15);
 131:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         peak ^= mask & (peak ^ t);
 132:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         pos ^= mask & (pos ^ i);
 133:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****         peak_abs ^= mask & (peak_abs ^ abs);
 134:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     }
 135:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     // set bit 7
 136:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     pos |= 128 & (uint16_t)((peak >> 15) - 1);
 137:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c ****     return (uint8_t) pos;
 138:/home/pacl/Documents/Repository/sca-2026/lib/crypto_kem/hqc128/pqclean/reed_muller.c **** }
