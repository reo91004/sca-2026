# editor / agent caches
.claude
.codex
.mcp.json
docs/*.md

# python
__pycache__/
*.pyc
*.pyo
docs/latex

# capture artifacts (regenerated by scripts/smoke.sh, host/capture.py)
traces/*
!traces/.gitkeep

# analysis output (regenerated by scripts/plot_*.py)
results/*
!results/.gitkeep

# firmware intermediate build dirs
firmware/*/objdir-*/
firmware/*/.dep/

# firmware build outputs (regenerated by `make`)
firmware/*/*.bin
firmware/*/*.elf
firmware/*/*.hex
firmware/*/*.eep
firmware/*/*.lss
firmware/*/*.lst
firmware/*/*.map
firmware/*/*.sym
firmware/*/*.o
