# editor / agent caches
.claude
.codex
.mcp.json

# python
__pycache__/
*.pyc
*.pyo

# capture artifacts (regenerated by scripts/ntruplus/run_main_capture.sh,
# scripts/smaug/smoke.sh, host/capture.py)
traces/*
!traces/.gitkeep

# analysis output (regenerated by per-track scripts).  Per-track subdir
# structure is preserved via .gitkeep markers so a fresh clone still shows
# the SMAUG-T / NTRU+ separation.
results/**
!results/
!results/ntruplus/
!results/smaug/
!results/**/.gitkeep

# firmware intermediate build dirs
firmware/*/objdir-*/
firmware/*/.dep/

# firmware build outputs (regenerated by `make`)
firmware/*/*.bin
firmware/*/*.elf
firmware/*/*.hex
firmware/*/*.eep
firmware/*/*.lss
firmware/*/*.lst
firmware/*/*.map
firmware/*/*.sym
firmware/*/*.o

upstream/